{
	"name": "openmail",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@9.0.0",
	"scripts": {
		"dev": "next dev --port 10000",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
		"db:migrate": "wrangler d1 migrations apply mail-db",
		"db:remote:migrate": "wrangler d1 migrations apply mail-db --remote",
		"db-viewer": "drizzle-kit studio ",
		"email-worker:dev": "wrangler dev --config ./wrangler.email.jsonc",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.5.5",
		"@langchain/core": "^1.1.32",
		"@langchain/openai": "^1.2.13",
		"@opennextjs/cloudflare": "^1.17.1",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.1",
		"@radix-ui/react-slot": "^1.1.1",
		"better-auth": "^1.5.5",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.1",
		"dompurify": "^3.3.3",
		"drizzle-orm": "^0.41.0",
		"langchain": "^1.2.32",
		"lucide-react": "^0.577.0",
		"next": "16.1.5",
		"postal-mime": "^2.7.4",
		"react": "19.1.5",
		"react-dom": "19.1.5",
		"tailwind-merge": "^2.6.0",
		"worker-mailer": "^1.2.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20.19.37",
		"@types/nodemailer": "^7.0.11",
		"@types/react": "^19.1.5",
		"@types/react-dom": "^19.1.5",
		"dotenv": "^17.3.1",
		"drizzle-kit": "^0.31.0",
		"eslint": "^9",
		"eslint-config-next": "15.4.6",
		"nodemailer": "^8.0.2",
		"tailwindcss": "^4",
		"typescript": "^5.7.4",
		"wrangler": "^4.73.0"
	}
}

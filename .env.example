# AUTH
BETTER_AUTH_SECRET=z+Zpf/+l28oTmCCx55Ni9zKXMCDaB006vzY9wC5JQIU= # random key
BETTER_AUTH_URL=example.com # you domain

GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com 
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
ADMIN_EMAIL=admin@gmail.com # your gmail account

# Mailer Provider Choice used for initial bootstrap/fallback.
# Once system_config exists in D1, mailer reads provider/credentials from D1 first.
MAIL_PROVIDER=resend

# Resend (bootstrap/fallback)
RESEND_API_KEY=re_xxxxxxxx 

# SMTP Configuration (bootstrap/fallback)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=xxxxxx 

{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "openmail-email",
	"main": "src/email-worker.ts",
	"compatibility_date": "2026-03-12",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"d1_databases": [
		{
			"binding": "MAIL_DB",
			"database_name": "mail-db",
			"database_id": "5e306c11-67a9-4449-b6d0-e5fabbd0913c"
		}
	],
	"r2_buckets": [
		{
			"binding": "MAIL_R2",
			"bucket_name": "mail-raw"
		}
	],
	"triggers": {
		"crons": [
			"0 0 * * *"
		]
	},
	// "ai": {
	// 	"binding": "AI"
	// }
}
